@model TaskMan.Models.User

@{
	ViewData["Title"] = "Edit Profile";
}

<h1>Edit Profile</h1>
<hr />
<div class="row">
	<div class="col-md-8">
		<div class="col-sm-9">
			<img src="~/images/user.png" alt="Default Profile Picture of user" class="profile_pic" />
		</div>
		<form asp-action="Edit">
			@Html.AntiForgeryToken()
			<div asp-validation-summary="ModelOnly" class="text-danger"></div>
			<input type="hidden" asp-for="User_ID" />


			<div class="form-group">
				<label asp-for="Username" class="col-sm-3 col-form-label"></label>
				<div class="col-sm-9">
					<input asp-for="Username" class="form-control" id="Username" type="text" />
					<span asp-validation-for="Username" class="text-danger"></span>
				</div>
			</div>
			<div class="form-group">
				<label asp-for="Email" class="col-sm-3 col-form-label"></label>
				<div class="col-sm-9">
					<input asp-for="Email" class="form-control" id="Email" type="text" />
					<span asp-validation-for="Email" class="text-danger"></span>
				</div>
			</div>

			<div class="form-group">
				<label class="col-sm-3 col-form-label"></label>
				<div class="col-sm-9">
					<input type="submit" value="Save" class="btn btn-primary" />
				</div>
			</div>
		</form>
	</div>
</div>

<div>
	<a asp-action="Index">Back to List</a>
</div>

@section Scripts {
	@{
		await Html.RenderPartialAsync("_ValidationScriptsPartial");
	}
}
