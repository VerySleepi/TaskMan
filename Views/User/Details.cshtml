@model TaskMan.Models.User

@{
	ViewData["Title"] = "User Details";
}
<div class="col-md-8">
	<table>
		<tr>
			<th>User ID</th>
			<td>@Model.User_ID</td>
		</tr>
		<tr>
			<th>Username</th>
			<td>@Model.Username</td>
		</tr>
		<tr>
			<th>Email</th>
			<td>@Model.Email</td>
		</tr>
		<tr>
			<th>Creation Date</th>
			<td>@Model.Creation_Date.ToString("yyyy-MM-dd")</td>
		</tr>
	</table>
</div>
<div>
	<a class="btn btn-sm btn-info" asp-action="Edit" asp-route-id="@Model.User_ID">Edit</a> |
	<a class="btn btn-sm btn-secondary" asp-action="Index">Back to List</a>
</div>
