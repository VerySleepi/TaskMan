@model IEnumerable<TaskMan.Models.User>

@{
	ViewData["Title"] = "Index";
	var heading = ViewData["Header"];
}
@Html.AntiForgeryToken()

<h1>@heading</h1>
<hr />
<p>
	<a class="btn btn-sm btn-danger" asp-action="Create">Create User</a>
</p>
<table class="table">
	<thead>
		<tr>
			<th>
				@Html.DisplayNameFor(model => model.User_ID)
			</th>
			<th>
				@Html.DisplayNameFor(model => model.Username)
			</th>
			<th>
				@Html.DisplayNameFor(model => model.Email)
			</th>
			<th></th>
		</tr>
	</thead>
	<tbody>
		@foreach (var item in Model)
		{
			<tr>
				<td>
					@Html.DisplayFor(modelItem => item.User_ID)
				</td>
				<td>
					@Html.DisplayFor(modelItem => item.Username)
				</td>
				<td>
					@Html.DisplayFor(modelItem => item.Email)
				</td>
				<td>
					<a class="btn btn-sm btn-success" asp-action="Edit" asp-route-id="@item.User_ID">Edit</a>
					<a class="btn btn-sm btn-info" asp-action="Details" asp-route-id="@item.User_ID">Details</a>
					<a class="btn btn-sm btn-danger" onclick="DeleteUser('@item.User_ID')">Delete</a>
				</td>
			</tr>
		}
	</tbody>
</table>

<link href="https://cdn.jsdelivr.net/npm/sweetalert2@11.26.17/dist/sweetalert2.min.css" rel="stylesheet" />
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11.26.17/dist/sweetalert2.all.min.js"></script>

<script>
	var DeleteUser = function (user_id) {

		// Read anti-forgery token value generated by html.antiforgerytoken()
		var token = $('input[name="__RequestVerificationToken"]').val();

		Swal.fire({
			title: 'Do you want to delete this item?',
			icon: 'warning',
			showCancelButton: true,
			confirmButtonText: 'Yes, delete it!'
		}).then((result) => {
			if (result.isConfirmed){
				$.ajax({
					type: "POST",
					url: '@Url.Action("Delete", "User")',
					data: { user_id: User_ID},
