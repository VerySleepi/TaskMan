@using TaskMan.ViewModels.Account;
@model LoginViewModel;

@{
    ViewData["Title"] = "Login";
    Layout = "~/Views/Shared/_AccountLayout.cshtml";
}

<div class="account-container">
    <div class="account-box">
        <h2 class="account-title">Login</h2>
        <form asp-action="Login" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="field-error"></div>
            <div>
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" class="form-input" autocomplete="off" aria-label="Input for email"/>
                <span asp-validation-for="Email" class="field-error"></span>
                </div>
            <div>
                <label asp-for="Password" class="form-label"></label>
                <input asp-for="Password" class="form-input" type="password" role="textbox" aria-label="Input for password"/>
                <span asp-validation-for="Password" class="field-error"></span>
            </div>
            <div class="form-account-link">
                <div class="form-checkbox">
                    <label class="form-label" asp-for="RememberMe">
                        <input asp-for="RememberMe" type="checkbox" role="checkbox" aria-label="Checkbox for remembering user"/>
                        @Html.DisplayNameFor(a => a.RememberMe)
                    </label>
                </div>
                <a asp-controller="Account" asp-action="VerifyEmail" class="account-link" role="link" aria-label="Link to forgot password page">
                    Forgot Password?
                </a>
            </div>
            <div class="account-footer">
                <button type="submit" class="form-submit-btn" role="button">Login</button>
                <p>
                    Don't have an account? <a asp-controller="Account" asp-action="Register" class="account-link" aria-label="Link to register page">Register</a>
                </p>
            </div>
        </form>
    </div>
</div>

@section Scripts {
	@{
		await Html.RenderPartialAsync("_ValidationScriptsPartial.cshtml");
	}
}