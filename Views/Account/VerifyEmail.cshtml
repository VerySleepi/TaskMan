@using TaskMan.ViewModels.Account;
@model VerifyEmailViewModel;

@{
    ViewData["Title"] = "Verify Email";
    Layout = "~/Views/Shared/_AccountLayout.cshtml";
}

<div class="account-container">
    <div class="account-box">
        <h2 class="account-title">Verify your Email</h2>
        <form asp-action="VerifyEmail" asp-controller="Account" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="field-error"></div>
            <div>
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" class="form-input" aria-label="Input for email"/>
                <span asp-validation-for="Email" class="field-error"></span>
            </div>

            <div class="account-footer">
                <button type="submit" class="form-submit-btn" aria-label="Verify email button">Verify</button>
                <div>
                    <a asp-controller="Account" asp-action="Login" class="account-link" aria-label="Back to Login page">Back</a>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial.cshtml");
    }
}