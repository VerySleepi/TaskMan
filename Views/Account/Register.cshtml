@using TaskMan.ViewModels.Account;
@model RegisterViewModel;

@{
    ViewData["Title"] = "Register";
    Layout = "~/Views/Shared/_AccountLayout.cshtml";
}

<div class="account-container">
    <div class="account-box">
        <h2 class="account-title">Register</h2>
        <form asp-action="Register" asp-controller="Account" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="field-error"></div>
            <div>
                <label asp-for="Username" class="form-label"></label>
                <input asp-for="Username" class="form-input" aria-required="true" autocomplete="off" aria-label="Input for username" />
                <span asp-validation-for="Username" class="field-error"></span>
            </div>
            <div>
                <label asp-for="Email" class="form-label" ></label>
                <input asp-for="Email" class="form-input" autocomplete="off" aria-label="Input for email" />
                <span asp-validation-for="Email" class="field-error"></span>
            </div>
            <div>
                <label asp-for="Password" class="form-label" ></label>
                <input asp-for="Password" class="form-input" type="password" autocomplete="off" aria-label="Input for password" />
                <span asp-validation-for="Password" class="field-error"></span>
            </div>
            <div>
                <label asp-for="ConfirmPassword" class="form-label" ></label>
                <input asp-for="ConfirmPassword" class="form-input" type="password" autocomplete="off" aria-label="Input for confirming password" />
                <span asp-validation-for="ConfirmPassword" class="field-error"></span>
            </div>
            <div class="account-footer">
                <button type="submit" class="form-submit-btn" role="button">Register</button>
                <p>
                    Already have an account? <a asp-controller="Account" asp-action="Login" class="account-link">Login</a>
                </p>
                <div>
                    <a asp-controller="Account" asp-action="Login" class="account-link">Back</a>
                </div>
            </div>

        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial.cshtml");
    }
}