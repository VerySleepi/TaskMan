@using TaskMan.ViewModels.Account;
@model ChangePasswordViewModel;

@{
    ViewData["Title"] = "Change Password";
    Layout = "~/Views/Shared/_AccountLayout.cshtml";
}

<div class="account-container">
    <div class="account-box">
        <h2 class="account-title">Change Password</h2>
        <form asp-action="ChangePassword" asp-controller="Account" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="field-error"></div>
            <div>
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" class="form-input" readonly aria-label="Read-only input for Email"/>
            </div>
            <div>
                <label asp-for="NewPassword" class="form-label"></label>
                <input asp-for="NewPassword" class="form-input" type="password" aria-label="Input for New Password"/>
                <span asp-validation-for="NewPassword" class="field-error"></span>
            </div>
            <div>
                <label asp-for="ConfirmNewPassword" class="form-label"></label>
                <input asp-for="ConfirmNewPassword" class="form-input" type="password" aria-label="Input for Confirm New Password"/>
                <span asp-validation-for="ConfirmNewPassword" class="field-error"></span>
            </div>
            <div class="account-footer">
                <button type="submit" class="form-submit-btn">Change Password</button>
                <div>
                    <a asp-controller="Account" asp-action="Login" class="account-link">Back</a>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial.cshtml");
    }
}