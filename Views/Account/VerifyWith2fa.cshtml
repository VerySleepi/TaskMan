@using TaskMan.ViewModels.Account;
@model TwoFactorAuthenticationViewModel;
@{
    ViewData["Title"] = "Two-Factor Authentication";
    Layout = "~/Views/Shared/_AccountLayout.cshtml";
}

<div class="account-container">
    <div class="account-box">
        <h2 class="account-title">Enter 2FA code</h2>
        <form asp-action="VerifyWith2fa" asp-controller="Account" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="field-error"></div>
            <div>
                <label asp-for="UserId" hidden></label>
                <input asp-for="UserId" hidden/>
            </div>
            <div>
                <input asp-for="Code" class="form-input" autocomplete="off" aria-label="Input for 2FA code"/>
                <span asp-validation-for="Code" class="field-error"></span>
            </div>
            <div class="account-footer">
                <button type="submit" class="form-submit-btn">Verify</button>
                <div>
                    <a asp-controller="Account" asp-action="Login" class="account-link">Back</a>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial.cshtml");
    }
}