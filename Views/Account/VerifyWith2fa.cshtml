@using TaskMan.ViewModels.Account;
@model TwoFactorAuthenticationViewModel;
@{
    ViewData["Title"] = "Two-Factor Authentication";
    Layout = "~/Views/Shared/_AccountLayout.cshtml";
}

<div class="account-container">
    <div class="account-box">
        <h2 class="text-center mb-4">Enter 2FA code</h2>
        <form asp-action="VerifyWith2fa" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="mb-3">
                <label asp-for="UserId" class="form-check-label" hidden></label>
                <input asp-for="UserId" class="form-check-input" hidden/>
            </div>
            <div class="mb-3">
                <input asp-for="Code" class="form-control" autocomplete="off"/>
                <span asp-validation-for="Code" class="text-danger"></span>
            </div>
            <input type="submit" value="Submit" class="btn btn-success w-100 p-2" />
            <div class="text-center mt-2">
                <a asp-controller="Account" asp-action="Login" class="text-decoration-none mt-3">Back</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial.cshtml");
    }
}