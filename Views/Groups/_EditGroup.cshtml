@model TaskMan.ViewModels.Group.NewGroupViewModel

<form asp-controller="Groups" asp-action="EditGroup" method="post">
    @Html.AntiForgeryToken()

    <input type="hidden" name="groupId" value="@Model.GroupId" />

    <div class="form-group">
        <label asp-for="Title">Title</label>
        <input asp-for="Title" class="list-input" placeholder="Enter Group Title" />
    </div>

    <div class="form-group">
        <label asp-for="Description">Description</label>
        <textarea asp-for="Description" class="list-input" placeholder="Enter Group Description"></textarea>
    </div>

    <button type="submit" class="submissionBtn">Apply</button>

</form>