@model TaskMan.ViewModels.Group.GroupDetailViewModel

<form asp-controller="Groups" asp-action="AddMembers" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" name="groupId" value="@Model.Group.Group_ID" />

    <div class="member-panel-grid">
        @foreach (var user in Model.NonMembers)
        {
            <div class="member-panel" data-user-id="@user.Id">
                <span><img src="#" alt="Alternate Text" /></span>
                <p>@user.UserName</p>
                <p>@user.Email</p>
            </div>
        }
    </div>

    <div id="addSelectedIds"></div>

    <button type="submit" class="submissionBtn">Add Members</button>
</form>
