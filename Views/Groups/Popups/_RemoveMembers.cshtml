@model TaskMan.ViewModels.Group.GroupDetailViewModel

<form asp-controller="Groups" asp-action="RemoveMembers" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" name="groupId" value="@Model.Group.Group_ID" />

    <div class="member-panel-grid">
        @foreach (var user in Model.Members)
        {
            @if (user.GroupUser.Role != "Admin")
            {
                <div class="member-panel" data-user-id="@user.User.Id" tabindex="0" aria-label="Member Panel for User @user.User.UserName">
                    <span><img src="@ViewData["profilePic"]" alt="Profile picture" class="profile_pic" /></span>
                    <p>@user.User.UserName</p>
                    <p>@user.User.Email</p>
                </div>
            }
        }
    </div>

    <div id="removeSelectedIds"></div>

    <button type="submit" class="submissionBtn" aria-label="Remove selected members button">Remove</button>
</form>
