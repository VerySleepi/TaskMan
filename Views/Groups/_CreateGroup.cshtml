@model TaskMan.ViewModels.Group.NewGroupViewModel

<form asp-controller="Groups" asp-action="Create" method="post">
    @Html.AntiForgeryToken()

    <div class="form-group">
        <label asp-for="Title">Title</label>
        <input id="groupTitle" asp-for="Title" class="list-input" placeholder="Enter Group Title"/>
    </div>

    <div class="form-group">
        <label asp-for="Description">Description</label>
        <textarea id="groupDescription" asp-for="Description" class="list-input" placeholder="Enter Group Description"></textarea>
    </div>

    <button type="submit" class="submissionBtn">Create Group</button>

</form>