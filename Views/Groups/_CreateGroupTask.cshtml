@model TaskMan.ViewModels.Group.NewGroupTaskViewModel

@{
    ViewData["Title"] = ViewData["Context"]?.ToString() == "Edit" ? "Edit Task" : "New Task";
}

<h3>
    @ViewData["Title"]
</h3>

<form asp-controller="Groups" asp-action="@(ViewData["Context"]?.ToString() == "Edit" ? "EditGroupTask" : "CreateGroupTask")"
      method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Group_ID" />
    <input type="hidden" asp-for="Status" />

    @if (ViewData["Context"]?.ToString() == "Edit")
    {
        <input type="hidden" value="@Model.Group_Task_ID" name="taskId" />
    }
   

    <div class="form-group">
        <label asp-for="Title">Title</label>
        <input id="groupTaskTitle" asp-for="Title" class="list-input" placeholder="Enter Task Title" />
    </div>

    <div class="form-group">
        <label asp-for="Description">Description</label>
        <textarea id="groupTaskDescription" asp-for="Description" class="list-input" placeholder="Enter Task Description"></textarea>
    </div>

    <div class="form-group">
        <label asp-for="Due_Date">Due Date</label>
        <input id="groupTaskDueDate"
               asp-for="Due_Date"
               type="date"
               class="task-select"
               min="@DateTime.Now.ToString("yyyy-MM-dd")"
               max="@DateTime.Now.AddYears(1).ToString("yyyy-MM-dd")" />
    </div>

    <div class="form-group">
        <label asp-for="Group_List_ID">Task List</label>
        <div id="groupTaskListDropdown" class="list-dropdown">

            <button type="button" class="list-dropdown-btn" id="groupTaskListToggle">
                <span id="groupTaskListSelected">
                    @(Model.GroupLists.FirstOrDefault(list => list.Group_List_ID == Model.Group_List_ID)?.Title ?? "Select Task List")
                </span>
            </button>


            <input asp-for="Group_List_ID"
                   type="hidden"
                   id="groupTaskListID"
                   value="@Model.Group_List_ID"/>
    

            <ul class="list-dropdown-list hidden">
                @foreach (var list in Model.GroupLists)
                {
                    <li class="list-dropdown-item">
                        <button type="button" value="@list.Group_List_ID">
                            @list.Title
                        </button>
                    </li>
                }
            </ul>
        </div>
    </div>
    @if (ViewData["Context"]?.ToString() == "Edit")
    {
        <button type="submit" class="submissionBtn">Apply</button>
    }
    else
    {
        <button type="submit" class="submissionBtn">Create Task</button>
    }

</form>