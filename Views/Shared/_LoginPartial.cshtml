@using Microsoft.AspNetCore.Identity;
@inject SignInManager<User> signInManager;


    @if (signInManager.IsSignedIn(User))
    {
        <li class="nav-item mt-sm-auto">
            <p class="nav-link align-middle px-0 text-white">
                <i class="fs-4 bi bi-house-fill"></i><span class="ms-1 d-none d-sm-inline">Welcome @ViewBag.userName!</span>
            </p>
        </li>
        <div id="logoutButton" class="nav-item">       
            <form asp-controller="Account" asp-action="Logout" method="post" class="nav-link align-middle px-0 text-white">
                @Html.AntiForgeryToken()
                <i class="fs-4 bi bi-house-fill"></i><button type="submit" class="ms-1 d-none d-sm-inline btn nav-link text-white">Logout</button>
            </form>
        </div>
    }
    else
    {
        <li class="nav-item">
            <a  class="nav-link text-white" asp-controller="Account" asp-action="Login">Login</a>
        </li>
        <li class="nav-item">
            <a class="nav-link text-white" asp-controller="Account" asp-action="Register">Register</a>
        </li>
    }



    