@model TaskMan.ViewModels.Tasks.NewListViewModel

<form asp-controller="Tasks" asp-action="CreateList" method="post">
    @Html.AntiForgeryToken()

    <div class="form-group">
        <label for="listTitle">Title</label>
        <input id="listTitle" asp-for="Title" class="list-input" placeholder="Enter List Title" aria-label="List Title"/>
    </div>

    <div class="form-group">
        <label for="listDescription">Description</label>
        <textarea id="listDescription" asp-for="Description" class="list-input" placeholder="Enter List Description" aria-label="List Description"></textarea>
    </div>

    <div class="form-group bg-group">
        <p>Background</p>
        <ul id="bg-list">
            @foreach (var bg in Model.BackgroundColors)
            {
                var colorId = $"bg-{bg.TrimStart('#')}";

                <li aria-label="List Background @bg">
                    <input id="@colorId" class="bg-radio" type="radio"  asp-for="BckGr_Col" value="@bg" />
                    <label for="@colorId" class="bg-label" style="--fillCol: @bg;"></label>
                </li>
            }
        </ul>
    </div>

    <button type="submit" class="submissionBtn" aria-label="Create List Button">Create List</button>

</form>