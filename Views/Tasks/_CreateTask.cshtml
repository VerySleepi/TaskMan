@model TaskMan.ViewModels.Tasks.NewTaskViewModel

<form class="taskForm" asp-controller="Tasks" asp-action="CreateTask" method="post">
    <div class="form-group">
        <label for="taskTitle">Title</label>
        <input id="taskTitle" asp-for="Title" class="task-input" />
    </div>

    <div class="form-group">
        <label for="taskDescription">Description</label>
        <textarea id="taskDescription" asp-for="Description" class="task-input"></textarea>
    </div>

    <div class="form-group">
        <label for="taskDueDate">Due Date</label>
        <input id="taskDueDate"
               asp-for="Due_Date"
               type="date"
               class="task-select"
               min="@DateTime.Now.ToString("yyyy-MM-dd")"
               max="@DateTime.Now.AddYears(1).ToString("yyyy-MM-dd")" /> 
    </div>

    <div class="form-group">
        <label for="selectTaskList">Task List</label>
        <select id="selectTaskList" asp-for="User_List_ID" class="task-select">
            @foreach (var list in Model.UserTaskLists)
            {
                <option value="@list.User_List_ID">@list.Title</option>
            }
        </select>
    </div>

    <button id="createTaskBtn" type="submit">Create Task</button>

</form>