@using TaskMan.ViewModels.Tasks;
@using Microsoft.AspNetCore.Html;
@model DashboardViewModel;

@{
    ViewData["Title"] = "Tasks";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/css/tasks.css" asp-append-version="true" />
}

<div class="cardContainer">
    <div class="cardList">
        <div class="addButtons">
            <button id="newListBtn" class="addBtn">
                New List
            </button>
            <button id="newTaskBtn" class="addBtn">
                Add Task
            </button>
        </div>

        @* Goes through each UserTask and its associated Tasks to create a card for each UserTask, displaying the tasks within it. *@

        @foreach (var usertasks in Model.StructuredUserTasks)
        {
            <div class="task-card" style="--bg-col: @usertasks.UserTask.BckGr_Col;">
                <div class="card-header">
                    <div>
                        <h5 class="card-title">@usertasks.UserTask.Title</h5>
                        <p>@usertasks.UserTask.Progress%</p>
                    </div>
                    @if (usertasks.UserTask.Title != "To-do")
                    {
                        <form class="deleteListForm" method="post" asp-action="DeleteList" asp-controller="Tasks">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="listId" value="@usertasks.UserTask.User_List_ID" />
                            <button type="button" class="listDeleteBtn danger-btn" aria-label="Delete List">Delete</button>
                        </form>
                    }
                    
                </div>
                <div class="card-body">
                    <ul class="cardObjectList" aria-label="Task List @usertasks.UserTask.Title">
                        @foreach (var task in usertasks.Tasks)
                        {
                            @* Each list item uses data attributes to store tasks information to be used in JavaScript *@
                            <li class="taskObject"
                                data-task-id="@task.Task_ID"
                                data-task-title="@task.Title"
                                data-task-description="@task.Description"
                                data-task-due-date="@task.Due_Date.ToString("yyyy-MM-dd")"
                                data-task-status="@task.Status"
                                data-task-list-id="@task.User_List_ID">
                                <div class="taskObject-content">
                                    <h6>@task.Title</h6>
                                    <p><strong>Due Date:</strong> @task.Due_Date.ToString("yyyy-MM-dd")</p>
                                </div>
                                <div class="button-group-horizontal">
                                    <form class="deleteTaskForm" method="post" asp-action="DeleteTask" asp-controller="Tasks">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="taskId" value="@task.Task_ID" />
                                        <button type="button" class="taskDeleteBtn danger-btn" aria-label="Delete Task"><img src="@ViewData["trashIcon"]" alt="Delete" class="deleteIcon" /></button>
                                    </form>

                                    <button type="button" class="taskEditBtn edit-btn" data-task-id="@task.Task_ID"><img src="@ViewData["editIcon"]" alt="Edit" class="editIcon" /></button>
                                    <form method="post" asp-action="TaskCompletion" asp-controller="Tasks">
                                        <input type="hidden" name="taskId" value="@task.Task_ID" />
                                        @if (task.Status == 1)
                                        {
                                            <input type="checkbox" class="task-checkbox" checked aria-label="Mark @task.Title Incomplete" />
                                        }
                                        else
                                        {
                                            <input type="checkbox" class="task-checkbox" aria-label="Mark @task.Title Complete" />
                                        }
                                    </form>
                                </div>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        }
    </div>
</div>

@*In hindsight, this panel could be a partial view to keep the dashboard view cleaner, such as with the new task popups *@
<div id="taskDetailsPanel" class="task-detail-panel hidden" aria-label="Task Details Panel" aria-live="polite">
    <button type="button" class="panelCloseBtn close-btn"><strong>✕</strong></button>
    <div class="panel-body">
        <h4 id="panelTitle"></h4>
        <p id="panelDescription"></p>
        <p id="panelDueDate"></p>
        <p id="panelStatus"></p>

        <div class="panel-actions button-group-horizontal">
            <form id="taskPanelCompleteForm" method="post" asp-action="TaskCompletion" asp-controller="Tasks">
                @Html.AntiForgeryToken()
                <input type="hidden" name="taskId" id="taskPanelCompleteInput" value="" />
                <button type="submit" aria-label="Mark Task Complete Button" id="taskPanelCompleteBtn" class="complete-btn">Mark Complete</button>
            </form>

            <button aria-label="Edit Task Button" class="taskPanelEditBtn edit-btn" data-task-id="">Edit Task</button>
        </div>
    </div>
</div>


@*The following overlays could have been partial views, similar to the new task popups *@
<div id="deleteTaskOverlay" class="overlay hidden">
    <div id="deleteTaskContent" class="popup-content">
        <p class="confirm-msg">Are you sure you want to delete this task?</p>
        <div class="button-group-horizontal">
            <button type="button" id="deleteTaskConfirmBtn" class="danger-btn">Delete</button>
            <button type="button" id="deleteTaskCancelBtn" class="cancel-btn">Cancel</button>
        </div>
    </div>
</div>

<div id="deleteListOverlay" class="overlay hidden">
    <div class="popup-content">
        <p class="confirm-msg">Are you sure you want to delete this list and all its tasks?</p>
        <div class="button-group-horizontal">
            <button type="button" id="deleteListConfirmBtn" class="danger-btn">Delete</button>
            <button type="button" id="deleteListCancelBtn" class="cancel-btn">Cancel</button>
        </div>
    </div>
</div>



@*Render the appropriate popup views here*@

@await Html.PartialAsync("~/Views/Tasks/Popups/_NewTaskPopUp.cshtml")
@await Html.PartialAsync("~/Views/Tasks/Popups/_NewTaskListPopUp.cshtml")

@section Scripts {
    <script src="~/js/tasks.js" asp-append-version="true"></script>
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial.cshtml");
    }
}