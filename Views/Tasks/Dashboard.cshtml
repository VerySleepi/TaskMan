@using TaskMan.ViewModels.Tasks;
@using Microsoft.AspNetCore.Html;
@model DashboardViewModel;

@{
    ViewData["Title"] = "Tasks";
    Layout = "~/Views/Shared/_TaskLayout.cshtml";
}

<div class="cardContainer">
    <div id="addTaskButton">
        <button id="newTaskBtn" class="btn btn-primary"> 
            Add
        </button>
    </div>
    @foreach (var usertasks in Model.structuredUserTasks)
    {
        <div class="card mb-3 task-card" style="--bg-col: @usertasks.UserTask.BckGr_Col;">
            <div class="card-header border-bottom-0">
                <h5 class="card-title">@usertasks.UserTask.Title</h5>
            </div>
            <div class="card-body">
                <ul class="cardObjectList">
                    @foreach (var task in usertasks.Tasks)
                    {
                        <li class="taskObject">
                            <h6>@task.Title</h6>
                            <p><strong>Due Date:</strong> @task.Due_Date.ToString("yyyy-MM-dd")</p>
                            <p><strong>Status:</strong> @task.Status</p>
                        </li>
                    }
                </ul>
            </div>
        </div>
    }
</div>

@await Html.PartialAsync("_NewTaskPopUp")

@section Scripts {
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/tasks.js" asp-append-version="true"></script>
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial.cshtml");
    }
}